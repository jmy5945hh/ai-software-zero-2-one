{
  "name": "zero-one-software",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,agent -c blue,green \"vite --host 0.0.0.0\" \"tsx server/index.ts\"",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:agent": "tsx server/index.ts",
    "start:agent": "npm install && tsx server/index.ts",
    "test:server": "tsx --test server/httpAuth.test.ts server/httpRoutes.test.ts server/wsHandler.test.ts server/utils/buildCommand.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck:server && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "vite": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
